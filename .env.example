# Default: local loopback-only demo. No cloud credentials are needed.
GOOD_EXCEPTION_MODE=demo
# GOOD_EXCEPTION_DATA_DIR=/absolute/path/to/local/demo-data
# GOOD_EXCEPTION_NEXT_DIR=.next

# Production API configuration (never put real secrets in this file):
# GOOD_EXCEPTION_MODE=production
# GOOGLE_CLOUD_PROJECT=your-project-id
# FIRESTORE_DATABASE_ID=(default)
# GOOD_EXCEPTION_ALLOWED_ORIGINS=https://your-frontend.example
# GOOD_EXCEPTION_REQUIRE_MFA=true
# Supply GOOD_EXCEPTION_PSEUDONYM_KEY securely through Secret Manager (>=32 chars).
# Firebase Admin SDK uses workload identity / application default credentials.

# Local tests set both emulator variables together. Never set these in Cloud Run.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Live Gemini, media, analytics, queues and messaging are not enabled.
